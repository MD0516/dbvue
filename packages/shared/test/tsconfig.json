{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": false,
        "rootDir": "..",
        "outDir": "../dist-test",
        "types": [
            "node"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "verbatimModuleSyntax": true
    },
    "include": [
        "./**/*.ts",
        "../src/**/*.ts"
    ],
    "exclude": [
        "../node_modules",
        "../dist",
        "../dist-test"
    ]
}